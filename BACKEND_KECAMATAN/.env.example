# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.

# development | test | production
NODE_ENV=development

# Hostinger mengisi PORT otomatis. Di lokal default 3000.
PORT=3000
HOST=0.0.0.0

# Zona waktu untuk nomor registrasi (Tarakan = WITA)
APP_TIMEZONE=Asia/Makassar

# Asal (origin) frontend yang boleh mengakses API, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Proxy tepercaya, agar rate limit membaca IP asli pengunjung.
#   false            = tidak di belakang proxy (lokal / akses langsung)
#   loopback         = proxy di mesin yang sama (127.0.0.1 / ::1), umumnya Hostinger
#   IP/CIDR,IP/CIDR  = daftar alamat proxy, mis. "loopback,173.245.48.0/20" bila ada Cloudflare
# "true" ditolak karena membuat siapa pun bisa memalsukan IP lewat header X-Forwarded-For.
# Cara cek: lihat README bagian Deploy.
TRUST_PROXY=false

# Saat ini hanya "mock" (login tanpa password, khusus pengembangan dan demo).
AUTH_MODE=mock
# Di NODE_ENV=production, server menolak start dengan auth mock,
# kecuali flag ini sengaja diisi true (misalnya untuk demo ke mitra).
ALLOW_MOCK_AUTH_IN_PRODUCTION=false

# Akun Petugas Pelayanan pertama, dibuat saat start bila username itu belum ada.
# Akun lain dibuat lewat menu Kelola Akun. Setelah masuk dan mengganti password, hapus PETUGAS_AWAL_PASSWORD.
# PETUGAS_AWAL_USERNAME=pelayanan
# PETUGAS_AWAL_PASSWORD=
# PETUGAS_AWAL_NAMA=Petugas Pelayanan
# Masa berlaku sesi login (menit) dan maksimal sesi aktif per akun
SESSION_TTL_MINUTES=480
MAX_SESI_PER_USER=5

# Jumlah maksimal entri jejak audit yang disimpan
AUDIT_LOG_MAX=10000

# Halaman dokumentasi API di /docs.
# Biarkan dikomentari: otomatis aktif di development dan mati di production.
# ENABLE_DOCS=true

# Batas ukuran per berkas (MB) dan jumlah berkas per pengajuan
MAX_FILE_MB=2
MAX_FILES_PER_PENGAJUAN=15

# Rate limit (permintaan per menit per IP)
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_LACAK=10
RATE_LIMIT_LOGIN=10

# Lacak: setelah N kali 4 digit HP salah untuk SATU nomor registrasi, nomor itu dikunci sekian menit
LACAK_MAX_GAGAL=5
LACAK_KUNCI_MENIT=15

# Contoh pengajuan di berbagai status saat start (untuk demo frontend).
# Default: aktif di development, mati di production. Hapus tanda # untuk memaksa.
# SEED_DEMO_PENGAJUAN=true
# Dengan DB_DRIVER=mysql bawaannya mati.

# Penyimpanan data: memory (hilang saat restart, dipakai tes) atau mysql.
# Dengan mysql, tabel dipasang otomatis saat server start.
DB_DRIVER=memory
# Di server Hostinger 127.0.0.1. Dari laptop pakai srvNNNN.hstgr.io, setelah IP laptop
# didaftarkan di hPanel > Databases > Remote MySQL.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# Isi password hanya di .env lokal atau di environment variables hPanel.
# DB_PASSWORD=

# Lokasi folder data master (default: ./data)
# DATA_DIR=./data

LOG_LEVEL=info
